    "views": [
      {
        "id": "viw-grid-0001",
        "name": "全部任务",
        "view_type": "grid",
        "config": {
          "card_title_field": "fld-title",
          "card_cover_field": "fld-cover",
          "filters": {
            "conjunction": "and",
            "conditions": [
              { "field": "fld-status", "operator": "is_not", "value": "done" },
              { "field": "fld-priority", "operator": "is_greater", "value": 1 }
            ]
          },
          "filter_groups": {
            "conjunction": "or",
            "groups": [
              { "conjunction": "and", "conditions": [
                { "field": "fld-status", "operator": "is", "value": "doing" },
                { "field": "fld-owner", "operator": "is", "value": "usr-0001" }
              ] },
              { "conjunction": "and", "conditions": [
                { "field": "fld-tags", "operator": "contains", "value": "urgent" }
              ] }
            ]
          },
          "sorts": [
            { "field": "fld-priority", "order": "desc" },
            { "field": "fld-due", "order": "asc" }
          ],
          "groups": [
            { "field": "fld-status", "order": "asc", "collapsed": ["done"] }
          ]
        }
      },
      {
        "id": "viw-cards-0002",
        "name": "卡片投影验收",
        "view_type": "grid",
        "field_order": ["fld-status", "fld-count", "fld-cover", "fld-title", "fld-desc", "fld-tags", "fld-priority", "fld-owner"],
        "visible_fields": ["fld-title", "fld-cover", "fld-tags", "fld-desc", "fld-count", "fld-status", "fld-priority"],
        "groups": [
          { "field_id": "fld-status", "order": "asc" }
        ],
        "config": { "hidden_fields": ["fld-count"] }
      },
      {
        "id": "viw-prefill-0001",
        "name": "进行中（可预填）",
        "view_type": "grid",
        "filters": [
          { "id": "flt-status", "field_id": "fld-status", "operator": "is", "value": "doing", "enabled": true },
          { "id": "flt-owner", "field_id": "fld-owner", "operator": "equals", "value": "usr-0001", "enabled": true },
          { "id": "flt-due", "field_id": "fld-due", "operator": "IS", "value": "2026-08-20", "enabled": true },
          { "id": "flt-progress-by-name", "field_id": "进度", "operator": "equals", "value": 0.4, "enabled": true },
          { "id": "flt-done-missing-enabled", "field_id": "fld-done", "operator": "is", "value": true },
          { "id": "flt-priority-disabled", "field_id": "fld-priority", "operator": "equals", "value": 5, "enabled": false }
        ],
        "groups": [{ "field_id": "fld-status", "direction": "asc" }],
        "filter": {
          "conjunction": "and",
          "filterSet": [
            { "field_id": "fld-title", "operator": "equals", "value": "TRAP-FROM-NESTED-FILTER" }
          ]
        },
        "config": {
          "filter_logic": "and",
          "filters": {
            "conjunction": "and",
            "conditions": [
              { "field": "fld-status", "operator": "is", "value": "todo" },
              { "field": "fld-title", "operator": "is", "value": "TRAP-FROM-CONFIG-FILTERS" }
            ]
          },
          "groups": [{ "field": "fld-priority", "order": "asc" }],
          "filter_groups": {
            "conjunction": "and",
            "groups": [
              { "conjunction": "and", "conditions": [
                { "field": "fld-tags", "operator": "is", "value": "review" }
              ] }
            ]
          }
        }
      },
      {
        "id": "viw-prefill-or-0001",
        "name": "或逻辑（筛选跳过）",
        "view_type": "grid",
        "filters": [
          { "id": "flt-or-status", "field_id": "fld-status", "operator": "is", "value": "doing", "enabled": true },
          { "id": "flt-or-owner", "field_id": "fld-owner", "operator": "equals", "value": "usr-0001", "enabled": true }
        ],
        "groups": [{ "field_id": "fld-tags", "direction": "asc" }],
        "config": { "filter_logic": "or" }
      },
      {
        "id": "viw-prefill-conflict-0001",
        "name": "同字段冲突",
        "view_type": "grid",
        "filters": [
          { "id": "flt-conflict-status-a", "field_id": "fld-status", "operator": "is", "value": "doing", "enabled": true },
          { "id": "flt-conflict-owner", "field_id": "fld-owner", "operator": "equals", "value": "usr-0001", "enabled": true },
          { "id": "flt-conflict-status-b", "field_id": "fld-status", "operator": "is", "value": "todo", "enabled": true }
        ],
        "groups": [{ "field_id": "fld-status", "direction": "asc" }],
        "config": { "filter_logic": "and" }
      },
      {
        "id": "viw-prefill-array-0001",
        "name": "单元素数组算子",
        "view_type": "grid",
        "filters": [
          { "id": "flt-tags-one", "field_id": "fld-tags", "operator": "  IS_ANY_OF  ", "value": ["urgent"], "enabled": true },
          { "id": "flt-status-in", "field_id": "fld-status", "operator": "in", "value": ["doing"], "enabled": true }
        ],
        "config": { "filter_logic": "and" }
      },
      {
        "id": "viw-prefill-array-multi-0001",
        "name": "多元素数组不产出",
        "view_type": "grid",
        "filters": [
          { "id": "flt-tags-two", "field_id": "fld-tags", "operator": "is_any_of", "value": ["urgent", "review"], "enabled": true },
          { "id": "flt-status-in-two", "field_id": "fld-status", "operator": "in", "value": ["doing", "todo"], "enabled": true },
          { "id": "flt-owner-keep", "field_id": "fld-owner", "operator": "equals", "value": "usr-0001", "enabled": true }
        ],
        "config": { "filter_logic": "and" }
      },
      {
        "id": "viw-prefill-negation-0001",
        "name": "非预填算子",
        "view_type": "grid",
        "filters": [
          { "id": "flt-not", "field_id": "fld-status", "operator": "is_not", "value": "done", "enabled": true },
          { "id": "flt-gt", "field_id": "fld-priority", "operator": "is_greater", "value": 1, "enabled": true },
          { "id": "flt-contains", "field_id": "fld-tags", "operator": "contains", "value": "urgent", "enabled": true },
          { "id": "flt-title-exactly", "field_id": "fld-title", "operator": "is_exactly", "value": "契约验收标题", "enabled": true }
        ],
        "config": { "filter_logic": "and" }
      },
      {
        "id": "viw-prefill-readonly-0001",
        "name": "不可写字段不预填",
        "view_type": "grid",
        "filters": [
          { "id": "flt-created", "field_id": "fld-created-at", "operator": "is", "value": "2026-08-10T10:00:00+08:00", "enabled": true },
          { "id": "flt-created-by", "field_id": "fld-creator", "operator": "equals", "value": "usr-0002", "enabled": true },
          { "id": "flt-link", "field_id": "fld-project", "operator": "equals", "value": ["rec-1001"], "enabled": true },
          { "id": "flt-attach", "field_id": "fld-spec", "operator": "equals", "value": "file-a-0001", "enabled": true }
        ],
        "config": { "filter_logic": "and" }
      },
      { "id": "viw-list-0001", "name": "清单", "view_type": "list", "config": {} },
      {
        "id": "viw-kanban-0001",
        "name": "状态看板",
        "view_type": "kanban",
        "config": { "group_field": "fld-status" }
      },
      { "id": "viw-calendar-0001", "name": "排期日历", "view_type": "calendar", "config": { "date_field": "fld-due" } },
      { "id": "viw-gallery-0001", "name": "封面画廊", "view_type": "gallery", "config": {} },
      { "id": "viw-future-0001", "name": "甘特图", "view_type": "gantt", "config": { "start_field": "fld-created-at", "end_field": "fld-due" } }
