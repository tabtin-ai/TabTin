  "prefixRules": [
    {
      "prefix": "tab",
      "match": "contains_search_or_get_or_list",
      "labelKey": "tab_search",
      "icon": "Search",
      "summaryKind": "query",
      "timelineStyle": "compact"
    },
    {
      "prefix": "tab",
      "match": "contains_delete_or_archive_or_trash",
      "labelKey": "tab_remove",
      "icon": "Trash2",
      "summaryKind": "generic",
      "timelineStyle": "card"
    },
    {
      "prefix": "tab",
      "match": "contains_restore_or_rollback",
      "labelKey": "tab_restore",
      "icon": "RefreshCw",
      "summaryKind": "generic",
      "timelineStyle": "card"
    },
    {
      "prefix": "tab",
      "match": "contains_create_or_insert_or_add",
      "labelKey": "tab_create",
      "icon": "PlusCircle",
      "summaryKind": "generic",
      "timelineStyle": "card"
    },
    {
      "prefix": "tab",
      "match": "contains_update_or_edit_or_write",
      "labelKey": "tab_update",
      "icon": "FilePenLine",
      "summaryKind": "generic",
      "timelineStyle": "card"
    },
    {
      "prefix": "tab",
      "match": "contains_publish_or_share_or_grant",
      "labelKey": "tab_publish",
      "icon": "Sparkles",
      "summaryKind": "generic",
      "timelineStyle": "card"
    },
    {
      "prefix": "tabdoc_",
      "match": "any",
      "labelKey": "tab_doc",
      "icon": "FileText",
      "summaryKind": "generic",
      "timelineStyle": "card"
    },
    {
      "prefix": "tabmemo_",
      "match": "any",
      "labelKey": "tab_memo",
      "icon": "FileText",
      "summaryKind": "generic",
      "timelineStyle": "card"
    },
    {
      "prefix": "tabsite_",
      "match": "any",
      "labelKey": "tab_site",
      "icon": "Globe",
      "summaryKind": "generic",
      "timelineStyle": "card"
    },
    {
      "prefix": "tabdata_",
      "match": "any",
      "labelKey": "tab_data",
      "icon": "Database",
      "summaryKind": "generic",
      "timelineStyle": "card"
    },
    {
      "prefix": "tab",
      "match": "any",
      "labelKey": "generic_tool",
      "icon": "Wrench",
      "summaryKind": "generic",
      "timelineStyle": "card"
    }
  ]
