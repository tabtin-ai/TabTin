        "en" : { "stringUnit" : { "state" : "translated", "value" : "When enabled, your chat content may be sent to third-party AI providers to generate responses." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启后，你的聊天内容可能会发送给第三方 AI 服务商以生成回复。" } }
