        "en" : { "stringUnit" : { "state" : "translated", "value" : "Review AI sharing disclosure" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看 AI 共享说明" } }
      }
    },
    "privacy.revokeAiConsent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Revoke consent" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "撤回同意" } }
      }
    },
    "privacy.revokeAiConsentTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Revoke AI data sharing?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "撤回 AI 数据共享同意？" } }
      }
    },
    "privacy.revokeAiConsentMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You will not be able to send messages to AI until you agree again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "撤回后将无法向 AI 发送消息，直到你再次同意。" } }
      }
    },
