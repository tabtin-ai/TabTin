      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Agree and Continue" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同意并继续" } }
      }
    },
    "privacy.aiConsentDecline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not Now" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂不同意" } }
