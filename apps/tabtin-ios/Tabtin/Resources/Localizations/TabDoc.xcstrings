    "tabDoc.complexContent.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This document is view-only here, and complex content keeps its original structure. Open the full editor to view everything and continue editing when permitted." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前文档在本页仅可查看，复杂内容会保留原格式。你可进入完整编辑器查看全部内容，并在有权限时继续编辑。" } } } },
    "tabDoc.complexContent.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This doc contains complex content" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文档含复杂内容" } } } },
    "tabDoc.complexTableContent.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Regular content and standard text cells can be edited here. Complex cells stay read-only so their original structure is preserved." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "普通正文和标准文本单元格可在此编辑；复杂单元格会保留原格式并保持只读。" } } } },
    "tabDoc.complexTableContent.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some cells are view-only" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "部分单元格仅可查看" } } } },
    "tabDoc.empty.editable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap to start writing" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轻点开始写作" } } } },
    "tabDoc.empty.readOnly" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This document is empty" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这是一份空文档" } } } },
    "tabDoc.fullEditorDraftWarning.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This native draft has not synced. The full editor will show the current cloud version. Continuing will permanently discard this draft from this device." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这份原生草稿尚未同步。完整编辑器将显示当前云端版本；继续将永久丢弃本机上的这份草稿。" } } } },
    "tabDoc.fullEditorDraftWarning.discardAndOpen" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Discard this draft and open" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "丢弃这份草稿并打开" } } } },
    "tabDoc.fullEditorDraftWarning.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Discard this draft and open?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "丢弃这份草稿并打开吗？" } } } },
    "tabDoc.fullEditorSaveRequired" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save the native draft before opening another editable surface. Your draft remains stored on this device." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先保存原生草稿，再打开另一处可编辑页面。草稿仍保存在本机。" } } } },
    "tabDoc.image.defaultAlt" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Document image" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文档图片" } } } },
