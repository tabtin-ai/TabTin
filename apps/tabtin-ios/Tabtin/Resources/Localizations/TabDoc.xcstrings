    "tabDoc.partialReadOnlyContent.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Editable content can still be changed here. Complex blocks keep their original structure and stay view-only. Open the full editor to edit them." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "支持的内容仍可在此编辑；复杂内容块会保留原格式并保持只读。如需修改复杂内容，请进入完整编辑器。" } } } },
