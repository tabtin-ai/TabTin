# 构建输出
out
out-test
# Wave 4 sticky 目录：NON_FATAL=1 抢出包后保存的失败 .map + manifest，给事后 retry 用。
# .map 文件每个数 MB+，开发者一次 hotfix 攒一堆 → 不 ignore 必污染 git status。
out-sourcemap-pending
dist
dist-app
dist-app-quick
dist-electron
.deploy-work
.deploy-active
.deploy-runs
.deploy-quick
.deploy-quick-*
.deploy-*-benchmark-*
# Windows pnpm deploy 路径叠写误产物（apps/tabtin-electron/apps/tabtin-electron/...）
/apps/

# 语义召回模型构建缓存（#3306）：fetch-embedding-model.mjs 置入，~130MB 不进 git
resources/models/

