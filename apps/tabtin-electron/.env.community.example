# Community distribution inputs are public endpoints, not credentials.
# The official local install needs no endpoint input and uses 127.0.0.1:6060.
# Set all four values when building for another self-hosted Community server.
# Company endpoints and unsafe metadata hosts are rejected.
TABTIN_COMMUNITY_API_BASE_URL=https://api.example.org/api
TABTIN_COMMUNITY_COLLAB_WS_BASE=wss://api.example.org/collab
TABTIN_COMMUNITY_CENTRIFUGO_WS_URL=wss://api.example.org/connection/websocket
TABTIN_COMMUNITY_PUBLIC_WEB_BASE_URL=https://web.example.org

# Optional. Leave unset to disable electron-updater in the packaged metadata.
# Only HTTPS feeds without embedded credentials are accepted.
# TABTIN_COMMUNITY_UPDATE_FEED_URL=https://downloads.example.org/tabtin-desktop

# Build-time identity; build-packaged-app.sh sets this automatically.
VITE_DISTRIBUTION_KIND=community
