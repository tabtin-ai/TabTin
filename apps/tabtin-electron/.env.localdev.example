# ===================================================
# TabTin 本地测试包（local）环境配置模板
#
# 用法：
#   1. 复制本文件为 .env.localdev：
#        cp apps/tabtin-electron/.env.localdev.example apps/tabtin-electron/.env.localdev
#   2. 把下方所有 <YOUR_LAN_IP> 改成你本机的 LAN IP（不是 localhost / 127.0.0.1，
#      因为 Electron WebContents 在 packaged 模式下与你机器不一定同网段）。
#      Mac:    ipconfig getifaddr en0   (Wi-Fi)
#              ipconfig getifaddr en1   (有线)
#      Linux:  ip route get 1.1.1.1 | awk '{print $7;exit}'
#   3. 确认你的本地后端使用标准端口——见下方"端口"段说明。
#   4. 跑 `pnpm build:mac:local` 打包；安装后所有 API/WS 都会走你本机的 Django/Centrifugo
#
# 用途（why local profile）：
#   1. 在 packaged 模式下复现/验证 React 错误（与 dev 不一样的 minify 行为）
#   2. 验证 client_errors 监控全链路：errorReporter → /report → admindash 反混淆
#   3. 验证 sourcemap 上传后的"还原堆栈"是否真的能定位源码
#
# ⚠ 本模板可以进 Git；你复制出来的 .env.localdev 已被 .gitignore，开发者本机
#   IP 不会泄露。
# ===================================================

# ---------- 后端入口 ----------
# 宿主 dev（scripts/dev/menu.sh，本机默认）：Django API 6060 / Collab 4100 / Centrifugo 8100
#   连接类端口以仓库根 .env 为准；本模板示例值与之对齐。
# 仅在显式的整机验收环境中覆盖为容器入口，勿与日常 dev 混跑。
#
# packaged 跨设备测试用 LAN IP（不是 localhost），避开某些 origin 限制：
VITE_API_BASE_URL=http://<YOUR_LAN_IP>:6060/api
TABTIN_API_BASE_URL=${VITE_API_BASE_URL}
# 公开分享页所在的 Web 入口；packaged renderer 自身是 tabtin-file://app，不能用来当外链。
VITE_PUBLIC_WEB_BASE_URL=http://<YOUR_LAN_IP>:5176
TABTIN_PUBLIC_WEB_BASE_URL=${VITE_PUBLIC_WEB_BASE_URL}
# 本地 tabtin-www 静态站（帮助中心）
VITE_WEBSITE_BASE_URL=http://<YOUR_LAN_IP>:8765
# 注册页协议链接；使用公开 OSS 地址，不附带会过期的临时签名。
VITE_USER_AGREEMENT_URL=https://assets.example.com/tabtin-agreement/TabTin%E6%A1%8C%E9%9D%A2%E7%AB%AF%E7%94%A8%E6%88%B7%E5%8D%8F%E8%AE%AE-V1.0%E4%B8%AD%E8%8B%B1%E5%8F%8C%E8%AF%AD%E7%89%88.pdf
VITE_PRIVACY_POLICY_URL=https://assets.example.com/tabtin-agreement/TabTin%E6%A1%8C%E9%9D%A2%E7%AB%AF%E9%9A%90%E7%A7%81%E6%94%BF%E7%AD%96-V1.0%E4%B8%AD%E8%8B%B1%E5%8F%8C%E8%AF%AD%E7%89%88.pdf
VITE_API_TIMEOUT=30000

# ---------- 协作 / 实时通信 WS（compose 与本机 dev 均为 4100/8100）----------
VITE_COLLAB_WS_BASE=ws://<YOUR_LAN_IP>:4100
VITE_COLLAB_WS_URL=ws://<YOUR_LAN_IP>:4100/collaboration
VITE_TABLE_COLLAB_WS_URL=ws://<YOUR_LAN_IP>:4100/table-collaboration
VITE_SLIDE_COLLAB_WS_URL=ws://<YOUR_LAN_IP>:4100/slide-collaboration
VITE_VIDEO_COLLAB_WS_URL=ws://<YOUR_LAN_IP>:4100/video-collaboration
VITE_DESIGN_COLLAB_WS_URL=ws://<YOUR_LAN_IP>:4100/design-collaboration
VITE_CANVAS_COLLAB_WS_URL=ws://<YOUR_LAN_IP>:4100/canvas-collaboration

# Centrifugo 实时通信（消息推送、业务事件）
VITE_CENTRIFUGO_WS_URL=ws://<YOUR_LAN_IP>:8100/connection/websocket

# ---------- 构建标识 ----------
# 渲染进程读 VITE_BUILD_PROFILE，可在标题栏 / About 页显示 (LOCAL)
VITE_BUILD_PROFILE=local

# VITE_APP_VERSION 默认读取 apps/tabtin-electron/package.json#version。
# CI / 调用方可显式 export VITE_APP_VERSION 覆盖；构建脚本会将最终值统一用于
# Vite、sourcemap app version 与 electron-builder。

# ---------- 调试面板开关 ----------
# 仅影响 local profile 打包产物；pnpm dev 下调试面板由 import.meta.env.DEV 默认开启，
# 不需要配置这个变量。
# true：本地测试包默认全开（LLMSnapshotPanel、BrowserResourceCenter Developer 等）
VITE_ENABLE_DEBUG_PANELS=true

# ---------- main 进程附加配置 ----------
ELECTRON_VERBOSE=false
