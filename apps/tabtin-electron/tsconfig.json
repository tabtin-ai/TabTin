{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@/*": ["src/renderer/src/*"],
      "@components/*": ["src/renderer/src/components/*"],
      "@stores/*": ["src/renderer/src/stores/*"],
      "@services/*": ["src/renderer/src/services/*"],
      "@hooks/*": ["src/renderer/src/hooks/*"],
      "@utils/*": ["src/renderer/src/utils/*"],
      "@types/*": ["src/renderer/src/types/*"],
      "@styles/*": ["src/renderer/src/styles/*"],
      "@apps-marketplace/*": ["../../packages/apps/*"],
      "@tabtin/crawlspace-core": ["../../packages/crawlspace-core/src/index.ts"],
      "@tabtin/checkpoint-core": ["../../packages/checkpoint-core/src/index.ts"],
      "@tabtin/file-history-core": ["../../packages/file-history-core/src/index.ts"],
      "@tabtin/chat-client": ["../../packages/tabtin-chat-client/src/index.ts"],
      "@tabtin/agent-runtime/official-plugins": ["../../packages/agent-runtime/src/official-plugins/index.ts"],
      "@tabtin/agent-runtime/plugins": ["../../packages/agent-runtime/src/plugins/index.ts"],
      "@tabtin/smartsheet-ui/toast-native": ["../../packages/smartsheet-ui/src/toast.ts"],
      "@tabtin/smartsheet-ui/message-native": ["../../packages/smartsheet-ui/src/message.ts"],
      "@tabtin/agent-modes/types": ["../../packages/agent-modes/dist/types.d.ts"],
      "@tabtin/table-core": ["../../packages/table-core/src/index.ts"],
      "@tabtin/table-ui": ["../../packages/table-ui/src/index.ts"],
      "@tabtin/table-engine": ["../../packages/table-engine/src/index.ts"],
      "@tabtin/tabdoc-ui": ["../../packages/tabdoc-ui/src/index.ts"],
      "@tabtin/tabdoc-ui/editor": ["../../packages/tabdoc-ui/src/editor/index.ts"],
      "@tabtin/tabdoc-ui/api-client": ["../../packages/tabdoc-ui/src/api-client.ts"],
      "@tabtin/tabdoc-ui/use-doc-editor": ["../../packages/tabdoc-ui/src/useDocEditor.ts"],
      "@tabtin/tabdoc-ui/use-collaborative-doc-editor": ["../../packages/tabdoc-ui/src/useCollaborativeDocEditor.ts"],
      "@tabtin/tabdoc-ui/use-doc-list": ["../../packages/tabdoc-ui/src/useDocList.ts"],
      "@tabtin/tabdoc-ui/ports": ["../../packages/tabdoc-ui/src/ports.ts"],
      "@tabtin/tabdoc-ui/locales": ["../../packages/tabdoc-ui/src/locales/index.ts"],
      "@tabtin/tabdoc-ui/rehype-sanitize-schema": ["../../packages/tabdoc-ui/src/rehypeSanitizeSchema.ts"]
    }
  },
  "include": [
    "src/**/*",
    "electron.vite.config.ts",
    "../../packages/apps/*/tool-cards/**/*.ts",
    "../../packages/apps/*/tool-cards/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "dist-app",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
