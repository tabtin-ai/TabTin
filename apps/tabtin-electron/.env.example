# TabTinCrawl 环境变量配置示例
# 复制此文件为 .env.local 并修改配置

# API 基础 URL
# 开发环境: https://api-test.example.com/api
# 生产环境: https://api.example.com
VITE_API_BASE_URL=https://api.example.com
TABTIN_API_BASE_URL=https://api.example.com

# 公开分享页 Web 入口（不要填 Electron 的 tabtin-file://app）
VITE_PUBLIC_WEB_BASE_URL=https://web.example.com
VITE_WEBSITE_BASE_URL=https://www.example.com

# 注册页协议链接；使用公开 OSS 地址，不附带会过期的临时签名。
VITE_USER_AGREEMENT_URL=https://www.example.com/terms
VITE_PRIVACY_POLICY_URL=https://www.example.com/privacy

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT=30000

# 应用环境
# development | production
NODE_ENV=development
