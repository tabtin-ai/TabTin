{
  "$defs": {
    "ArtifactIdentity": {
      "additionalProperties": false,
      "properties": {
        "canonical_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Canonical Hash",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "model-capability",
            "product-control-mapping",
            "runtime-wire-mapping",
            "protocol-readiness",
            "extension-target-allowlist",
            "deployment-profile",
            "model-deployment-binding",
            "rate-card",
            "platform-safety-policy",
            "rollout-policy",
            "projection-metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "revision",
        "canonical_hash"
      ],
      "title": "ArtifactIdentity",
      "type": "object"
    },
    "CredentialPoolRef": {
      "additionalProperties": false,
      "properties": {
        "pool_key": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Pool Key",
          "type": "string"
        }
      },
      "required": [
        "pool_key"
      ],
      "title": "CredentialPoolRef",
      "type": "object"
    },
    "ExactRef": {
      "additionalProperties": false,
      "properties": {
        "expected_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Expected Hash",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "model-capability",
            "product-control-mapping",
            "runtime-wire-mapping",
            "protocol-readiness",
            "extension-target-allowlist",
            "deployment-profile",
            "model-deployment-binding",
            "rate-card",
            "platform-safety-policy",
            "rollout-policy",
            "projection-metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "revision",
        "expected_hash"
      ],
      "title": "ExactRef",
      "type": "object"
    },
    "LifecycleState": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ],
      "title": "LifecycleState",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credential_pool_ref": {
      "$ref": "#/$defs/CredentialPoolRef"
    },
    "credential_type": {
      "default": "bearer",
      "title": "Credential Type",
      "type": "string"
    },
    "deployment_tags": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Deployment Tags",
      "type": "array"
    },
    "endpoint_key": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Endpoint Key",
      "type": "string"
    },
    "endpoint_policy_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "endpoint_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint Url"
    },
    "identity": {
      "$ref": "#/$defs/ArtifactIdentity"
    },
    "lifecycle": {
      "$ref": "#/$defs/LifecycleState"
    },
    "protocol_readiness_ref": {
      "$ref": "#/$defs/ExactRef"
    },
    "region": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region"
    },
    "replacement_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "sunset_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sunset At"
    }
  },
  "required": [
    "schema_version",
    "identity",
    "endpoint_key",
    "protocol_readiness_ref",
    "credential_pool_ref",
    "lifecycle"
  ],
  "title": "DeploymentProfile",
  "type": "object"
}
