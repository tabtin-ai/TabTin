{
  "$defs": {
    "ArtifactIdentity": {
      "additionalProperties": false,
      "properties": {
        "canonical_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Canonical Hash",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "model-capability",
            "product-control-mapping",
            "runtime-wire-mapping",
            "protocol-readiness",
            "extension-target-allowlist",
            "deployment-profile",
            "model-deployment-binding",
            "rate-card",
            "platform-safety-policy",
            "rollout-policy",
            "projection-metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "revision",
        "canonical_hash"
      ],
      "title": "ArtifactIdentity",
      "type": "object"
    },
    "ConditionNode": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConditionNode"
          },
          "title": "Children",
          "type": "array"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "operator": {
          "enum": [
            "all",
            "any",
            "not",
            "equals",
            "present"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "operator"
      ],
      "title": "ConditionNode",
      "type": "object"
    },
    "ExactRef": {
      "additionalProperties": false,
      "properties": {
        "expected_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Expected Hash",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "model-capability",
            "product-control-mapping",
            "runtime-wire-mapping",
            "protocol-readiness",
            "extension-target-allowlist",
            "deployment-profile",
            "model-deployment-binding",
            "rate-card",
            "platform-safety-policy",
            "rollout-policy",
            "projection-metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "revision",
        "expected_hash"
      ],
      "title": "ExactRef",
      "type": "object"
    },
    "MappingOperation": {
      "additionalProperties": false,
      "properties": {
        "input_value": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Value"
        },
        "operation": {
          "enum": [
            "set",
            "remove",
            "rename",
            "copy"
          ],
          "title": "Operation",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionNode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "operation",
        "target"
      ],
      "title": "MappingOperation",
      "type": "object"
    },
    "RuntimeExtensionPatch": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "enum": [
            "protocol.request.body",
            "protocol.request.headers",
            "protocol.request.query"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/MappingOperation"
          },
          "title": "Operations",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "namespace",
        "operations"
      ],
      "title": "RuntimeExtensionPatch",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identity": {
      "$ref": "#/$defs/ArtifactIdentity"
    },
    "mapping_role": {
      "const": "runtime-extension",
      "default": "runtime-extension",
      "title": "Mapping Role",
      "type": "string"
    },
    "patches": {
      "items": {
        "$ref": "#/$defs/RuntimeExtensionPatch"
      },
      "title": "Patches",
      "type": "array"
    },
    "product_mapping_ref": {
      "$ref": "#/$defs/ExactRef"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "identity",
    "product_mapping_ref",
    "patches"
  ],
  "title": "RuntimeWireMapping",
  "type": "object"
}
