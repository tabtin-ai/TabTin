# ========================================================================
# Agent Engine 配置（W11+）
# ------------------------------------------------------------------------
# 仅列出 "能通过 .env 直接生效" 的 7 个配置项。其余 100+ Django settings
# 属性（如 AGENT_ENGINE_MAX_TOOL_CALLS 等）需通过 AdminDash `ChatGlobalConfig`
# 或 `settings.py` 显式桥接，单纯在此 .env 设置不生效。
# 详见 docs/agent-runtime/agent-engine-env-rename-migration.md 第 5 节。
#
# 命名规则：AGENT_ENGINE_* 新名优先；ORCHESTRATION_* legacy 名仍兼容
# （命中会打一次 DeprecationWarning），将在 Wave 13（2026-06）移除。
# ========================================================================

# LiteLLM provider 映射（JSON 串）
AGENT_ENGINE_LITELLM_PROVIDER_ALIASES={"qwen":"dashscope","claude":"anthropic"}

# 子 Agent 结果压缩阈值（字符数）
# AGENT_ENGINE_COMPRESSOR_MAX_CHARS=3000
# AGENT_ENGINE_COMPRESSOR_MAX_INPUT_CHARS=20000

# Prompt Caching 开关
# AGENT_ENGINE_PROMPT_CACHE_ENABLED=False
# AGENT_ENGINE_PROMPT_CACHE_KEY_SCOPE=thread
# AGENT_ENGINE_PROMPT_CACHE_RETENTION=

# 进程启动时是否自动回收残留子 Agent（1=启用，0=禁用）
# AGENT_ENGINE_SUBAGENT_RECOVER_ON_STARTUP=1

# ========================================================================
# 其他 TabTin 配置（本文件仅是 Agent Engine 迁移的参考模板；
# 完整 .env 结构请参考当前仓库的 .env 或 deployment/ 下的生产模板）
# ========================================================================
