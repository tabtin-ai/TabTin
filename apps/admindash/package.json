{
  "name": "admindash",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node ../../scripts/admindash/workspace-build.mjs",
    "dev": "vite",
    "pretypecheck": "pnpm --filter admindash^... build",
