# collab-live 环境变量

# 服务端口
PORT=4100
# COLLAB_LIVE_PORT=4100  # 也可通过此变量设置

# Django 后端地址
DJANGO_API_URL=http://localhost:6060

# 内部服务密钥（与 Django settings.COLLAB_LIVE_SECRET 一致）
LIVE_SECRET=dev-placeholder-collab-secret

# CORS（生产环境必填，逗号分隔）
# 空时 HTTP 跨域被拒绝；WebSocket 端点由 JWT 独立认证，不受此配置影响
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://www.example.com

# 权限重验证间隔（毫秒）
# PermissionGuard 定时对所有活跃连接重新调用 Django verifyCollabAccess，
# 检测权限撤销和 JWT 过期。值越小安全窗口越短，但 Django 负载越高。
# 默认 60000（60 秒），生产环境建议 30000（30 秒）。
# PERMISSION_REVALIDATION_INTERVAL_MS=30000

# Hocuspocus 配置
HOCUSPOCUS_DEBOUNCE=10000
