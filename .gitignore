# -----------------------------------------------------------------------------
# reference/ 第三方镜像（本地 git clone，原以 gitlink 跟踪）
# 已从索引移除：避免子仓库内未提交改动导致主仓持续显示 Modified。
# 克隆主仓后若需要某镜像，请在 reference/ 下自行 clone；本仓仍保留
# reference/ 内非 gitlink 的文档与脚本（如 libtv-skill）。
# -----------------------------------------------------------------------------
/reference/
# tabwhiteboard v2 spike 临时产物（保留 spike 脚本本身，但忽略 node_modules
# 与每次跑的 cpu profile / trace JSON 输出，避免几十 MB 进版本库）
.cursor/plans/tabwhiteboard_v2/spikes/node_modules/
.cursor/plans/tabwhiteboard_v2/spikes/profile-output/

# 本人 Cursor 规则（软链自 work-brain/tabtin/user-personal-workspace.mdc，仅本机）
.cursor/rules/user-personal-workspace.mdc

# 验证 harness 本地截图（脚本入库，产物不入库）
scripts/verification/**/*.png

# 脚本/工具产物（dogfood / metrics / CLI binary）
/outputs/
/metrics/
/apps/tabtin-android/.kotlin/
/packages/tabtin-cli-go/tabtin-cli
/packages/tabtin-cli-go/tabtin-cli-*

