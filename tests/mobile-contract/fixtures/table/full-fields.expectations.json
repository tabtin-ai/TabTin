    ],
    "rules": [
      "标题字段：视图配置 card_title_field/title_field → is_primary → 第一个可见字段（不挑类型）",
      "封面字段：视图配置 card_cover_field/cover_field → 第一个 attachment/media 可见字段",
      "摘要：可见字段排除标题/封面后前 4 个；分组字段照常参与（Web 正典只排除标题与封面）",
      "config.hidden_fields 不是契约的一部分：Web 正典不读它，可见性只走 is_hidden/visible_fields/column_meta（裁定见 ）",
      "空标题显示「未命名记录」，禁止显示记录 ID",
      "新建记录预填：按当前视图筛选/分组值回填（resolveMobilePrefillValues 同规则）"
    ],
    "intentionalDeviations": [
      {
        "rule": "摘要跳过空值字段，取前 4 个有值的；Web 保留空位并渲染「—」",
        "appliesTo": [
          "ios",
          "android"
        ],
        "reason": "手机屏幕窄，占位行挤掉真实信息；经产品裁定保留双端行为，不按 Web 对齐"
      },
      {
        "rule": "配置的封面字段仍须是 attachment/media，否则不作封面",
        "appliesTo": [
          "ios",
          "android"
        ],
        "reason": "Web 会把任意配置字段的字符串值直接当图片地址取用，一处 url 字段配置就能让卡片去拉任意外链；移动端收紧不跟随"
      }
    ],
