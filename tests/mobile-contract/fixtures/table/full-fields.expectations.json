  "projectionCases": [
    {
      "id": "discriminating-cards",
      "view": "viw-cards-0002",
      "record": "rec-0001",
      "purpose": "viw-grid-0001 对卡片投影的多条规则没有鉴别力——分组字段、hidden_fields 目标字段都排在摘要前 4 的射程之外，实现反了夹具照样全绿。这个用例把每条规则的关键字段都摆进射程，任何一条实现跑偏都会改变投影结果。target 由 scripts/check-mobile-card-projection.mts 用 Web 正典实算校验，不是手写。",
      "discriminates": [
        "分组字段照常进摘要：fld-status 是 view.groups 的分组字段且排摘要首位，实现若排除分组字段，bodyFields 首项就变",
        "不读 config.hidden_fields：fld-count 被 hidden_fields 点名却必须留在摘要，实现若读它，bodyFields 会少一项",
        "primary 优先于首个可见字段：fld-title 是 primary 但只排可见第 4 位，实现若直接取首个可见字段，标题会变成 fld-status",
        "封面按类型回落并移出摘要：视图未配置 card_cover_field，fld-cover（media）须自动成为封面且不出现在 bodyFields",
        "摘要上限 4：fld-priority 是第 7 个可见字段，上限放宽就会冒出来",
        "visible_fields 决定可见性：fld-owner 在 field_order 里但不在 visible_fields 里，出现即漏过滤",
        "field_order 决定顺序：visible_fields 的排列与 field_order 刻意不同，把 visible_fields 当顺序用会得到 [fld-tags, fld-desc, fld-count, fld-status]"
      ],
      "target": {
        "titleField": "fld-title",
        "coverField": "fld-cover",
        "bodyFields": [
          "fld-status",
          "fld-count",
          "fld-desc",
          "fld-tags"
        ]
      },
      "current": {
        "ios": {
          "titleField": "fld-title",
          "coverField": "fld-cover",
          "bodyFields": [
            "fld-status",
            "fld-count",
            "fld-desc",
            "fld-tags"
          ]
        },
        "android": {
          "titleField": "fld-title",
          "coverField": "fld-cover",
          "bodyFields": [
            "fld-status",
            "fld-count",
            "fld-desc",
            "fld-tags"
          ]
        }
      }
    }
  ],
  "prefillCases": [
    {
      "id": "basic-filters",
      "view": "viw-prefill-0001",
      "groupValues": {},
      "purpose": "无 groupValues 时，顶层 filters 按字段名产出。视图里埋了 config.filters / config.groups / filter_groups / 顶层 filter（嵌套 FilterSet）四条陷阱，读错位置就会多出或改掉字段。",
      "discriminates": [
        "只读顶层 filters：config.filters.conditions 把状态写成 todo、标题写成陷阱值，读它就会改结果",
        "不读顶层 filter（嵌套 FilterSet）：Android 模型注释写「新 FilterSet 优先」，读它会多出任务名称",
        "不读 filter_groups：陷阱值是标签=review，出现即读错位置",
        "field_id 先按 id 再按 name：进度这条的 field_id 是中文名「进度」，只查 id 就会丢这个字段",
        "算子大小写不敏感：截止日期用的是 IS，只认小写 is 就会丢这个字段",
        "enabled 缺省视为启用：已验收没有 enabled 键，当成禁用就会丢这个字段",
        "enabled === false 跳过：优先级=5 被禁用，出现即没跳过",
        "结果 key 是字段名：出现 fld-status / fld-owner 即用了 id 当 key",
        "user / date 可写：负责人和截止日期必须出现"
      ],
      "target": {
