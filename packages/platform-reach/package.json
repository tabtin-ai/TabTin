{
  "name": "@tabtin/platform-reach",
  "version": "0.1.0",
  "description": "Platform Reach — per-platform content adapters over the shared TabWeb browser stack (platform routing + TabTin-native runtime)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2",
    "vitest": "4.0.18"
  },
  "files": [
    "dist"
  ]
}
