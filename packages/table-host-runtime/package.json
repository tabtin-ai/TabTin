{
  "name": "@tabtin/table-host-runtime",
  "version": "0.1.0",
  "description": "Shared runtime bootstrap for TabTin table hosts",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tabtin/app-host-sdk": "workspace:*",
    "@tabtin/contracts": "workspace:*",
    "@tabtin/table-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.2"
  }
}
