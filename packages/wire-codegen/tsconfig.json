{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./scripts",
    "allowImportingTsExtensions": false
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "fixtures"]
}
