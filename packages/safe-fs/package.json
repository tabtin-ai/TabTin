{
  "name": "@tabtin/safe-fs",
  "version": "0.1.0",
  "description": "TabTin filesystem wrapper — wraps node:fs with @tabtin/os-errors classification (TCC / NTFS ACL / cloud placeholder / AV detection)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@tabtin/os-errors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "5.7.2",
    "vitest": "^1.6.1"
  }
}
