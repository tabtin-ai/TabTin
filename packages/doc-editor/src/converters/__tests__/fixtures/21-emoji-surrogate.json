{
  "name": "emoji-surrogate",
  "description": "Emoji surrogate pair (U+1F600) within paragraph",
  "pmJson": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Hello " },
          { "type": "emoji", "attrs": { "name": "😀" } },
          { "type": "text", "text": " world" }
        ]
      }
    ]
  },
  "expectedMarkdown": "Hello 😀 world"
}
