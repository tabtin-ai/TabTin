{
  "name": "@tabtin/prompt-contract",
  "version": "0.1.0",
  "description": "Prompt section registry + audit helpers. Shared by @tabtin/agent-prompt and @tabtin/agent-runtime. Zero runtime deps.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "^3.1.1"
  }
}
