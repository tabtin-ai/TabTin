{
  "name": "@tabtin/local-docparse",
  "version": "0.1.0",
  "description": "Local document parsing (PDF/Word/Excel) shared across Electron / Daemon hosts — pdfjs-dist + mammoth + xlsx with quality-aware fallback to cloud",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workers": {
      "source": "./src/workers/index.ts",
      "types": "./dist/workers/index.d.ts",
      "import": "./dist/workers/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tabtin/file-pipeline-errors": "workspace:*",
    "mammoth": "1.12.0",
    "pdfjs-dist": "5.4.296",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "5.7.2",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "tabtin",
    "docparse",
    "pdfjs",
    "mammoth",
    "xlsx",
    "local-first"
  ],
  "author": "TabTin Team",
  "license": "MIT"
}
