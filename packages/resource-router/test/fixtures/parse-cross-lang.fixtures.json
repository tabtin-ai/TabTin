{
  "_doc": "双端 parse 字符级对齐测试 fixtures。TS 与 Python 镜像必须读这一份并产出 byte-equal 输出。新增样例时确保两端都能跑通。`expected.meta` 数组顺序无关——比对时按 key 排序。",
  "samples": [
    {
      "name": "self_format_minimal_table",
      "uri": "tabtin://resource/table/tbl_abc123",
      "expected": {
        "scheme": "tabtin",
        "type": "table",
        "id": "tbl_abc123",
        "raw": "tabtin://resource/table/tbl_abc123",
        "hint": null
      }
    },
    {
      "name": "self_format_preprod_table_record",
      "uri": "tabtin-preprod://resource/table/tbl_abc123?hint=tabdata&recordIds=rec_123",
      "expected": {
        "scheme": "tabtin",
        "type": "table",
        "id": "tbl_abc123",
        "raw": "tabtin-preprod://resource/table/tbl_abc123?hint=tabdata&recordIds=rec_123",
        "hint": "tabdata",
        "meta": { "recordIds": "rec_123" }
      }
    },
    {
      "name": "self_format_dev_table_record",
      "uri": "tabtin-dev://resource/table/tbl_abc123?hint=tabdata&recordIds=rec_123",
      "expected": {
        "scheme": "tabtin",
        "type": "table",
        "id": "tbl_abc123",
        "raw": "tabtin-dev://resource/table/tbl_abc123?hint=tabdata&recordIds=rec_123",
        "hint": "tabdata",
        "meta": { "recordIds": "rec_123" }
      }
    },
