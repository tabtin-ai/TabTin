        "raw": "tabtin://resource/document/doc_xyz?hint=tabdoc&title=%E9%A1%B9%E7%9B%AE%E6%96%B9%E6%A1%88",
        "hint": "tabdoc",
        "meta": { "title": "项目方案" }
