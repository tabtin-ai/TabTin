    {
      "name": "/etc/shadow",
      "pattern": "/etc/shadow\\b",
      "flags": "",
      "category": "system-auth",
      "description": "Unix /etc/shadow 用户密码哈希"
    },
    {
      "name": "/etc/gshadow",
      "pattern": "/etc/gshadow\\b",
      "flags": "",
      "category": "system-auth",
      "description": "Unix /etc/gshadow 用户组密码哈希"
    },
    {
