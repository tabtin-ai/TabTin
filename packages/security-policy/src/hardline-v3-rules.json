    },
    {
      "name": "/etc/passwd",
      "pattern": "/etc/passwd\\b",
      "flags": "",
      "category": "system-auth",
      "description": "Unix /etc/passwd 用户账户表"
    },
    {
      "name": "/etc/sudoers",
