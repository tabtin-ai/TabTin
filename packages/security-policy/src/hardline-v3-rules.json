      "flags": "",
      "category": "system-auth",
      "description": "sudoers 配置（提权）"
    },
    {
      "name": "/etc/sudoers.d",
      "pattern": "/etc/sudoers\\.d\\b",
      "flags": "",
      "category": "system-auth",
      "description": "sudoers drop-in 目录"
