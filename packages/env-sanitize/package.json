{
  "name": "@tabtin/env-sanitize",
  "version": "0.1.0",
  "description": "Environment variable sanitization for TabTin — strips dangerous injection vars and sensitive credentials",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:dts": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2",
    "vitest": "4.0.18"
  },
  "files": [
    "dist"
  ]
}
