{
  "name": "@tabtin/pty-core",
  "version": "0.1.0",
  "description": "Shared PTY core modules for TabTin (Electron & Daemon)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:dts": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tabtin/env-sanitize": "workspace:*"
  },
  "peerDependencies": {
    "node-pty": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "node-pty": "^1.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2",
    "vitest": "4.0.18"
  },
  "files": [
    "dist"
  ]
}
