{
  "name": "@tabtin/agent-modes",
  "version": "0.1.0",
  "description": "Agent Mode SSoT — mode definitions, tool policies, prompt sections, and cross-runtime contract",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node scripts/gen-prompt-sections.mjs",
    "build": "node scripts/gen-prompt-sections.mjs && tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "5.7.2"
  }
}
