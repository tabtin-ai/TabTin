{
  "name": "@tabtin/media-capabilities",
  "version": "0.1.0",
  "description": "Unified media capability layer — wraps local FFmpeg / media-core helpers and cloud services (Django API) into a single consumable interface for all product lines",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image": {
      "source": "./src/image/index.ts",
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.js"
    },
    "./video": {
      "source": "./src/video/index.ts",
      "types": "./dist/video/index.d.ts",
      "import": "./dist/video/index.js"
    },
    "./audio": {
      "source": "./src/audio/index.ts",
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    },
    "./middleware": {
      "source": "./src/middleware/index.ts",
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./routes": {
      "source": "./src/routes/index.ts",
      "types": "./dist/routes/index.d.ts",
      "import": "./dist/routes/index.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tabtin/media-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "4.0.18"
  }
}
