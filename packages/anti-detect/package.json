{
  "name": "@tabtin/anti-detect",
  "version": "0.1.0",
  "description": "TabTin anti-detect module (UA pool, proxy health, fingerprints, client hints)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client-hints": {
      "source": "./src/client-hints/index.ts",
      "types": "./dist/client-hints/index.d.ts",
      "import": "./dist/client-hints/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/client-hints/index.ts --format esm --dts",
    "build:dts": "tsup src/index.ts src/client-hints/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "@tabtin/crawl-integration": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist"
  ]
}
