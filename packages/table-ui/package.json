{
  "name": "@tabtin/table-ui",
  "version": "0.1.0",
  "description": "Reusable UI layer for TabTin table experiences",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./clipboard": {
      "source": "./src/controller/useDataGridClipboard.ts",
      "types": "./dist/controller/useDataGridClipboard.d.ts",
      "import": "./dist/controller/useDataGridClipboard.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "tabtin",
    "table",
    "ui"
  ],
  "author": "TabTin Team",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tabtin/smartsheet-ui": "workspace:*",
    "@tabtin/table-core": "workspace:*",
    "@tabtin/table-engine": "workspace:*",
    "lucide-react": "^0.487.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "jsdom": "^24.1.3",
    "typescript": "5.7.2",
    "vitest": "^1.6.1"
  }
}
