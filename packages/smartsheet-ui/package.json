{
  "name": "@tabtin/smartsheet-ui",
  "version": "0.1.0",
  "description": "Shared UI components for TabTin applications",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./toast": {
      "source": "./src/toast.ts",
      "types": "./dist/toast.d.ts",
      "import": "./dist/toast.js",
      "require": "./dist/toast.cjs"
    },
    "./message": {
      "source": "./src/message.ts",
      "types": "./dist/message.d.ts",
      "import": "./dist/message.js",
      "require": "./dist/message.cjs"
    },
    "./i18n": {
      "source": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "require": "./dist/i18n.cjs"
    },
    "./styles": "./dist/smartsheet-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist .test-dist",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "pnpm run test:node && pnpm run test:ui",
    "test:node": "pnpm run build:test && node -e \"require('node:fs').writeFileSync('.test-dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test .test-dist/tests/*.test.js",
    "test:ui": "vitest run"
  },
  "keywords": [
    "tabtin",
    "ui",
    "components",
    "react"
  ],
  "author": "TabTin Team",
  "license": "MIT",
  "peerDependencies": {
    "@dnd-kit/sortable": ">=7.0.0",
    "@dnd-kit/utilities": ">=3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": ">=14.0.0",
    "i18next": ">=23.0.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "i18next": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/react": "0.27.16",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tabtin/app-host-sdk": "workspace:*",
    "@tabtin/app-shell": "workspace:*",
    "@tabtin/table-core": "workspace:*",
    "@tabtin/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.487.0",
    "react-day-picker": "9.14.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "i18next": "^24.0.0",
    "jsdom": "29.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "typescript": "5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "4.1.0"
  }
}
