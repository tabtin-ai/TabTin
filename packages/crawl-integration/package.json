{
  "name": "@tabtin/crawl-integration",
  "version": "0.1.0",
  "description": "TabTin Crawl Integration - Browser control layer with Puppeteer Core + CDP",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.4.0",
    "@google/genai": "^1.22.0",
    "axios": "^1.6.0",
    "chrome-launcher": "^1.2.0",
    "devtools-protocol": "^0.0.1464554",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "puppeteer-core": "^24.23.0",
    "socks-proxy-agent": "^8.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.19.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "clean": "rm -rf dist build node_modules",
    "test:basic": "tsx examples/01-basic-test.ts",
    "test": "pnpm run test:basic"
  },
  "files": [
    "dist"
  ]
}
