# ============================================================================
# TabTin 开源开发环境变量模板（复制为 .env 后使用）
# ============================================================================
# 首次使用先执行 `cp .env.example .env`；Electron / AdminDash / Django / scripts/dev/menu.sh 读取根 .env。
# `.env` 与个人覆盖 `.env.local` 均不得提交。
#
# 启动：bash scripts/dev/menu.sh → 菜单 1；Electron：cd apps/tabtin-electron && pnpm dev
# 标准端口：Django 6060 / Collab 4100 / Centrifugo 8100
# 验收 deploy 栈时临时把 API 改成 8080，验完改回 6060。
# ============================================================================

# ── 本地开发模式切换（个人生效值写在 .env.local）────────────────────────────
# TABTIN_LOCAL_DEV_MODE：
#   native = 默认本地 dev（bash scripts/dev/menu.sh 菜单 1，连 127.0.0.1:6060）
#   lite   = 模式一：只启动 Electron/Web，API/WS 直连 ACK test
#   docker = 模式二：Docker 启动本地 Django/Collab 等，客户端连本地 Docker
#
# 切换时只改 .env.local 里的 TABTIN_LOCAL_DEV_MODE；下方是团队统一的预设 URL。

# 模式一（lite）：客户端 / 管理后台直连 ACK test
TABTIN_LITE_API_BASE_URL=
TABTIN_LITE_COLLAB_WS_BASE=
TABTIN_LITE_CENTRIFUGO_WS_URL=
TABTIN_LITE_PUBLIC_WEB_BASE_URL=
TABTIN_LITE_WEBSITE_BASE_URL=

# 模式二（docker）：客户端 / 管理后台连本地 Docker 服务（分享页走本地 tabtin-web）
TABTIN_DOCKER_API_BASE_URL=http://127.0.0.1:6060/api
TABTIN_DOCKER_COLLAB_WS_BASE=ws://127.0.0.1:4100
TABTIN_DOCKER_CENTRIFUGO_WS_URL=ws://127.0.0.1:8100/connection/websocket
TABTIN_DOCKER_PUBLIC_WEB_BASE_URL=http://127.0.0.1:5176
TABTIN_DOCKER_WEBSITE_BASE_URL=http://127.0.0.1:8765

# ── 客户端联调（Vite / Electron / AdminDash）────────────────────────────────
TABTIN_API_BASE_URL=http://127.0.0.1:6060/api
VITE_API_BASE_URL=http://127.0.0.1:6060/api
# tabtin-web 公开分享页 dev 入口（Electron Vite=5175，勿与 VITE_DEV_SERVER_PORT 混用）
VITE_PUBLIC_WEB_BASE_URL=http://127.0.0.1:5176
# tabtin-www 官网 dev 入口（帮助中心等外链）
VITE_WEBSITE_BASE_URL=http://127.0.0.1:8765
# 注册页协议链接；使用公开 OSS 地址，不附带会过期的临时签名。
VITE_USER_AGREEMENT_URL=https://www.example.com/terms
VITE_PRIVACY_POLICY_URL=https://www.example.com/privacy
VITE_API_TIMEOUT=30000
# 只设 BASE；各模块 collab WS 由代码按 `${BASE}/<x>-collaboration` 自动推导
# （renderer/web/tabslide 的 config 都是 `VITE_xxx_COLLAB_WS_URL ?? BASE 推导` 三层回退）。
# 切勿在此再写逐模块 VITE_*_COLLAB_WS_URL=localhost——打包时根 .env 会被先加载，
# 而 .env.preprod/.env.production 只覆盖 BASE、不覆盖逐模块 key，逐模块 localhost 会
# 漏进安装包并因「逐模块优先于 BASE」盖掉灰度/生产地址（实测 preprod 包 collab 连了 127.0.0.1）。
VITE_COLLAB_WS_BASE=ws://127.0.0.1:4100
VITE_CENTRIFUGO_WS_URL=ws://127.0.0.1:8100/connection/websocket
VITE_DEV_SERVER_PORT=5175
# 开源/自托管：同一输入框收邮箱或手机号。去掉空白后小写等于 false 才关闭。
VITE_AUTH_EMAIL_LOGIN_ENABLED=true
# 可选：本地 Electron 开发语言钉（仅 DEV）。未设置则跟随设置页偏好 / 系统语言。
# 例：VITE_DEV_LANGUAGE=en-US 或 zh-CN（改完需重启客户端）
# VITE_DEV_LANGUAGE=
VITE_DOC_COLLAB_ENABLED=true
SOURCEMAP_API_URL=http://127.0.0.1:6060
SOURCEMAP_UPLOAD_KEY=
ELECTRON_VERBOSE=true
# 浏览器容器（GH-4777 / #7183）：webview = DOM 合成，Agent 胶囊等主窗浮层与文档页同层。
# 默认 WCV 时原生层会盖住主窗 fixed 浮层——不要再为胶囊开 overlay 支线。
# 回退：TABTIN_BROWSER_CONTAINER=wcv 后**完全重启** Electron（Cmd+R 不够）。
TABTIN_BROWSER_CONTAINER=webview
# 开发态不初始化桌面更新模块，避免本地后端未启动时弹出更新失败提示。
# 该开关仅在 Electron dev 模式生效，不影响 preprod / production 安装包。
TABTIN_DISABLE_DEV_UPDATER=true

# ── release/0.1.0 发布期开关 ──────────────────────────────────────────
# Project：本地与 ACK test/preprod 开启；production profile 仍默认关闭。
# IM（消息）已常开，不再设开关。
VITE_ENABLE_PROJECTS_UI=true
TABTIN_ENABLE_PROJECTS=true

# ── Django 核心 ───────────────────────────────────────────────────────────
TABTIN_EDITION=community
TABTIN_REQUIRE_INVITE_CODE=false
DEBUG=True
SECRET_KEY=django-insecure-dev-placeholder-change-before-deploy
CREDENTIAL_ENCRYPTION_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOW_LAN_HOSTS_IN_DEBUG=True
# 本地开发弱网模拟：给所有 HTTP/WS 请求响应注入延迟（毫秒）。仅 DEBUG=True 生效，
# 留空或 <=0 表示不注入。改后需重启 Django/ASGI 进程。示例：DEV_RESPONSE_LATENCY_MS=800
DEV_RESPONSE_LATENCY_MS=
BILLING_AUTO_COLLECT_ENABLED=false
BILLING_INVOICE_COLLECTION_ENABLED=false
BILLING_HOURLY_AGGREGATE_CHARGE_ENABLED=false
BILLING_LEGACY_NON_LLM_CONSUME_ENABLED=false
BILLING_LEGACY_NON_LLM_USAGE_CHARGE_ENABLED=false

# ── 数据库（单库默认 single_pg + tabtin_single）────────────────────────────
TABTIN_DATABASE_MODE=single_pg
PG_DB_NAME=tabtin_single
PG_DB_USER=tabtin
PG_DB_PASSWORD=tabtin_dev_pass
PG_DB_HOST=127.0.0.1
PG_DB_PORT=5432

# ── Redis（Celery / Channels / Centrifugo）──────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/10
REDIS_DB=10

# ── Daemon Control（账号设备控制面）────────────────────────────────────────
DAEMON_CONTROL_ENABLED=false
VITE_ENABLE_DAEMON_CONTROL_UI=false
DAEMON_CONTROL_HTTP_ADDR=127.0.0.1:6080
# Daemon/Electron 通过公开 HTTP 契约登记设备；生产可由同域 /api 路由，无需显式配置。
TABTIN_DAEMON_CONTROL_API_BASE_URL=http://127.0.0.1:6080/api
# Django 与 Daemon Control 之间的共享鉴权令牌；两边配置必须一致且至少 32 字节。
DAEMON_CONTROL_INTERNAL_SERVICE_TOKEN=

# ── LLM ───────────────────────────────────────────────────────────────────
# MOONSHOT_API_KEY 请填在 .env.local（gitignore）；dev 启动时 provision_dev_agent_ready 会自动写入 LLMProvider。
LLM_SERVICE=qwen
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3-coder-flash
AGENT_ENGINE_LITELLM_PROVIDER_ALIASES={"qwen":"dashscope","claude":"anthropic"}
SEARCH_DEFAULT_PROVIDER=qianfan
QIANFAN_API_KEY=
BOCHA_API_KEY=
# 模型选择器展示 Provider 专享额度（「剩余专享 xx 点券」）；本地 demo 默认开
PROVIDER_CREDIT_UI_ENABLED=true

# ── 文件存储（本地 dev 默认 local；预发/生产显式改 aliyun）──────────────────
SERVICES_OSS_PROVIDER=local
LOCAL_OSS_BUCKET_NAME=tabtin-local-dev
LOCAL_OSS_ROOT=apps/tabtin_django/local-oss
LOCAL_OSS_PUBLIC_BASE_URL=http://127.0.0.1:6060/api/services/oss/local-object
LOCAL_OSS_UPLOAD_BASE_URL=http://127.0.0.1:6060/api/services/oss/local-upload

# ── Aliyun ──────────────────────────────────────────────────────────────────
ALIYUN_USE_ECS_ROLE=
ALIYUN_ECS_ROLE_NAME=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SECURITY_TOKEN=
ALIYUN_SMS_REGION=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_USE_INTERNAL=
ALIYUN_OSS_INTERNAL_ENDPOINT=

# IM 长期归档只使用独立私有 Bucket，不回退 ALIYUN_OSS_BUCKET_NAME，不配置 CDN/CORS。
IM_ARCHIVE_OBJECT_BACKEND=disabled
IM_ARCHIVE_OSS_BUCKET_NAME=
# 建议按环境和格式版本隔离，例如 im-archive/prod/v1。
IM_ARCHIVE_OSS_KEY_PREFIX=

# ── 支付 ────────────────────────────────────────────────────────────────────
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_CERT_SERIAL_NO=
WECHAT_APIV3_KEY=
WECHAT_NOTIFY_URL=
CREDITS_PER_YUAN=100
ORDER_EXPIRE_MINUTES=30

# ── AWS SES (TabMail) ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=
AWS_SES_CONFIGURATION_SET=
AWS_SNS_INBOUND_TOPIC_ARN=
AWS_S3_SES_BUCKET=

# ── 语音 / 音效 ─────────────────────────────────────────────────────────────
BYTEDANCE_ASR_APP_ID=
BYTEDANCE_ASR_ACCESS_TOKEN=
BYTEDANCE_ASR_SECRET_KEY=
FREESOUND_API_KEY=

# ── Sentry 错误监控（issue #3299，自部署 https://sentry.example.com，errors-only）───
# DSN 留空 = 不启用（SDK 不初始化，零开销）。DSN 是客户端公钥，可入库；
# 后台账号见团队密码管理。字段契约见 docs/agent/error-context-schema.md
# 本地开发默认不上报，避免开发机错误混入共享 test 问题池。
# ACK 的 test / production 部署必须显式注入对应 DSN；需要临时本地探针时，
# 仅在个人 .env.local 中设置，不要改回团队基线。
# Django 端（tabtin-django project）
SENTRY_DSN=
# 当前受治理的 test 池为 test-new；留空时按 DEBUG 推导
SENTRY_ENVIRONMENT=test-new
# 留空时 Django 端不带 release；Electron 端自动用 app 版本号
SENTRY_RELEASE=
# Electron 端（tabtin-electron project）：渲染进程经 Vite 注入，
# 主进程读同一变量（loadRootEnvironment 已把根 .env 灌进 process.env）
VITE_SENTRY_DSN=
# Electron 打包后 sourcemap 上传（upload-sentry-sourcemaps.sh）；DSN 公钥可入库，
# SENTRY_AUTH_TOKEN 是私密 token，放 ~/.config/tabtin-codesign/secrets.env 或 CI 注入
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Daemon 端（tabtin-daemon project）不读本文件：部署机上用
# `SENTRY_DSN` 环境变量或 `tabtin-daemon config --set sentry_dsn=...`，DSN 为
# https://73e6f18bf49673c46f06d6ee8adbbeaf@sentry.example.com/4

# ── iOS 原生 APNs（私钥勿写真值于此；部署机注入 / 本机写 .env.local）────────
# 任一凭据缺失 → 推送静默关闭并降级为 WS-only。
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.example.tabtin
# APNS_PRIVATE_KEY=
# APNS_PRIVATE_KEY_PATH=

# ── dev_only ────────────────────────────────────────────────────────────────
ENABLE_JINBAO_BOT=true
