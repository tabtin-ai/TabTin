# TabTin 本地搜索引擎环境变量示例
# 复制到未跟踪的本地 env 文件后按需覆盖。

SEARCH_ENGINE_ENABLED=false
SEARCH_ES_HOSTS=http://localhost:9200
SEARCH_ES_USER=
SEARCH_ES_PASSWORD=
SEARCH_ES_VERIFY_CERTS=false
SEARCH_ES_DISABLE_PRODUCT_CHECK=false
SEARCH_INDEX_PREFIX=tabtin

SEARCH_ES_TIMEOUT=5
SEARCH_ES_SEARCH_TIMEOUT_MS=500
SEARCH_INDEX_BUFFER_FLUSH_MS=500
SEARCH_INDEX_BUFFER_MAX_BATCH=100

FTS_BREAKER_FAIL_MAX=5
FTS_BREAKER_RESET_TIMEOUT=30
FTS_BREAKER_ERROR_RATE_THRESHOLD=0.5
FTS_BREAKER_NAMESPACE=fts_breaker
FTS_BREAKER_REQUIRE_REDIS=false
FTS_ACL_CACHE_TTL=300

CELERY_FTS_CONCURRENCY=4
CELERY_FTS_MAX_TASKS_PER_CHILD=1000
CELERY_FTS_MAX_MEMORY=512000
